{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thinkgrow:prepared-lesson:v1",
  "title": "ThinkGrow signed student lesson payload v1",
  "description": "Verify exact UTF-8 Signed.payload using Ed25519 domain thinkgrow.lesson.v1 + NUL before parsing. Native byte bounds and recipient/scope/time checks also apply. Text lessons only; required assets must fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "device_id",
    "school_id",
    "class_id",
    "assignment_id",
    "protocol",
    "app_id",
    "credential_epoch",
    "issued_ms",
    "expires_ms",
    "package_revision",
    "title",
    "prompt",
    "hint",
    "content",
    "starts_ms",
    "due_ms",
    "allow_late"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "school_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "class_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "protocol": {
      "const": 1
    },
    "app_id": {
      "const": "com.thinkgrow.offline.student"
    },
    "credential_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 1
    },
    "package_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 512
    },
    "prompt": {
      "type": "string",
      "maxLength": 32768
    },
    "hint": {
      "type": "string",
      "maxLength": 8192
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "min_length",
            "max_length"
          ],
          "properties": {
            "kind": {
              "const": "essay"
            },
            "min_length": {
              "type": "integer",
              "minimum": 0
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "true_false"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ],
          "properties": {
            "kind": {
              "const": "multiple_choice"
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "left",
            "right"
          ],
          "properties": {
            "kind": {
              "const": "matching"
            },
            "left": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "right": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ],
          "properties": {
            "kind": {
              "const": "ordering"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "max_length"
          ],
          "properties": {
            "kind": {
              "const": "short_answer"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "blanks"
          ],
          "properties": {
            "kind": {
              "const": "fill_in_blank"
            },
            "blanks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      ]
    },
    "starts_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "due_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "allow_late": {
      "type": "boolean"
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "text": {
          "type": "string",
          "maxLength": 8192
        }
      }
    }
  }
}
