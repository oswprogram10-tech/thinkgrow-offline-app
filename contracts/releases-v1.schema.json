{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thinkgrow:offline:releases:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "channel",
    "sequence",
    "issued_ms",
    "expires_ms",
    "online_repository",
    "online_commit",
    "offline_commit",
    "artifacts"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "channel": {
      "enum": [
        "stable",
        "beta"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "issued_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "expires_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "online_repository": {
      "const": "oswprogram10-tech/school-class-allinone-platform"
    },
    "online_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "offline_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "kind",
          "app_id",
          "platform",
          "version",
          "min_core",
          "protocol_min",
          "protocol_max",
          "schema_min",
          "schema_max",
          "url",
          "bytes",
          "sha256",
          "signature"
        ],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "kind": {
            "enum": [
              "app",
              "shared",
              "game"
            ]
          },
          "app_id": {
            "enum": [
              "com.thinkgrow.offline.teacher",
              "com.thinkgrow.offline.student",
              "com.thinkgrow.offline.parent"
            ]
          },
          "platform": {
            "enum": [
              "windows-x86_64",
              "android-aarch64",
              "ios-aarch64"
            ]
          },
          "version": {
            "type": "string"
          },
          "min_core": {
            "type": "string"
          },
          "protocol_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "protocol_max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "schema_min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "schema_max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1073741824
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    }
  }
}
