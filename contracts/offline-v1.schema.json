{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:thinkgrow:offline:protocol:1",
  "title": "ThinkGrow offline protocol v1",
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "school_id",
        "class_id",
        "assignment_id"
      ],
      "properties": {
        "school_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "class_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "Answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "school_id",
        "class_id",
        "assignment_id",
        "package_revision",
        "base_answer_revision",
        "body",
        "blobs"
      ],
      "properties": {
        "school_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "class_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "package_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "base_answer_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "body": {
          "type": "string",
          "maxLength": 2097152
        },
        "blobs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "maxItems": 64
        }
      }
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "app_id",
        "subject_id",
        "device_id",
        "device_public_key",
        "epoch",
        "issued_ms",
        "expires_ms",
        "scopes"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "app_id": {
          "enum": [
            "com.thinkgrow.offline.teacher",
            "com.thinkgrow.offline.student",
            "com.thinkgrow.offline.parent"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "device_public_key": {
          "type": "string"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "issued_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "expires_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "maxItems": 1024
        }
      }
    },
    "Signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "payload",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "payload": {
          "type": "string",
          "maxLength": 2097152
        },
        "signature": {
          "type": "string"
        }
      }
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation_id",
        "origin_device_id",
        "device_seq",
        "subject_id",
        "app_id",
        "credential_epoch",
        "kind",
        "answer",
        "draft_revision",
        "payload_hash"
      ],
      "properties": {
        "protocol": {
          "enum": [
            1,
            2
          ]
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "device_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "app_id": {
          "const": "com.thinkgrow.offline.student"
        },
        "credential_epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "kind": {
          "const": "submission"
        },
        "answer": {
          "$ref": "#/$defs/Answer"
        },
        "draft_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "Envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "proof"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "proof": {
          "type": "string"
        }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation_id",
        "origin_device_id",
        "subject_id",
        "payload_hash",
        "destination",
        "receipt_id",
        "server_received_ms"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "destination": {
          "enum": [
            "classroom",
            "online"
          ]
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "server_received_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Grant"
    },
    {
      "$ref": "#/$defs/Envelope"
    },
    {
      "$ref": "#/$defs/Receipt"
    },
    {
      "$ref": "#/$defs/Signed"
    }
  ]
}
