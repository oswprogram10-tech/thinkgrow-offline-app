{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "생각쑥쑥 학부모",
  "version": "0.1.0",
  "identifier": "com.thinkgrow.offline.parent",
  "build": {
    "frontendDist": "../../../target/ui/parent",
    "beforeBuildCommand": "node ../../scripts/build-ui.mjs parent",
    "beforeDevCommand": "node ../../scripts/build-ui.mjs parent"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "생각쑥쑥 학부모",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
