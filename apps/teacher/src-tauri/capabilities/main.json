{
  "identifier": "main-window",
  "description": "Role-specific local account registration and lock commands; no filesystem, shell or arbitrary network permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-core-status",
    "allow-account-status",
    "allow-register-account",
    "allow-unlock-account",
    "allow-change-account-pin",
    "allow-recover-account-pin",
    "allow-export-account-backup",
    "allow-restore-account-backup",
    "allow-lock-account",
    "allow-open-registration-page",
    "allow-load-role-workspace",
    "allow-role-exchange",
    "allow-list-role-drafts",
    "allow-save-role-draft",
    "allow-sync-role-draft",
    "allow-list-games",
    "allow-launch-game",
    "allow-stop-game"
  ]
}
