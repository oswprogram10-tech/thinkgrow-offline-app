{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "생각쑥쑥",
        "compression": "lzma",
        "template": "../../../installer/windows/installer.nsi"
      },
      "allowDowngrades": false
    },
    "resources": {
      "../../../installer/windows/LICENSE.Tauri-MIT": "licenses/Tauri-MIT.txt"
    }
  }
}
