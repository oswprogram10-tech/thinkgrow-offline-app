{
  "identifier": "main-window",
  "description": "Role-specific local account registration and lock commands; no filesystem, shell or arbitrary network permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-core-status",
    "allow-load-draft",
    "allow-save-draft",
    "allow-queue-submission",
    "allow-account-status",
    "allow-register-account",
    "allow-unlock-account",
    "allow-change-account-pin",
    "allow-recover-account-pin",
    "allow-export-account-backup",
    "allow-restore-account-backup",
    "allow-lock-account",
    "allow-open-registration-page",
    "allow-list-lessons",
    "allow-prepare-lessons",
    "allow-load-role-workspace",
    "allow-role-exchange",
    "allow-list-games",
    "allow-launch-game",
    "allow-stop-game",
    "allow-list-class-materials",
    "allow-open-material-file",
    "allow-save-material-chunk",
    "allow-delete-material",
    "allow-launch-online-game",
    "allow-launch-material-app"
  ]
}
